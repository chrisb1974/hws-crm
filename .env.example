# Copier en .env, jamais commiter le résultat (voir .gitignore).

# Connexion directe Postgres — migrations, psql, scripts/migrate.py.
# Recuperer sur https://supabase.com/dashboard/project/_/settings/database
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# API REST/PostgREST du projet.
SUPABASE_URL=https://[PROJECT-REF].supabase.co

# Cle publique (frontend, RLS appliquee). Pas encore utilisee : RLS non ecrite (voir README).
SUPABASE_ANON_KEY=

# Cle service_role — contourne RLS. Ne JAMAIS l'exposer cote client ni la commiter.
SUPABASE_SERVICE_ROLE_KEY=

# Cle du role svc_gscripts, utilisee par apps_script/01_shim_supabase.gs
# (Script Properties du projet Apps Script, pas ce fichier — a emettre une fois
# le role et les grants poses, cf. sql/04_compat_gosiyaha.sql section 7).
# SUPABASE_KEY=
